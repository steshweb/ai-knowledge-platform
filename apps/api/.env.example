NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Optional during Phase 1; required when Prisma-backed features are introduced.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Authentication secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Gemini embeddings. Keep the API key only in a local/deployment environment.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
