{
  "name": "ai-knowledge-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-knowledge-platform/web --filter @ai-knowledge-platform/api dev",
    "dev:web": "pnpm --filter @ai-knowledge-platform/web dev",
    "dev:api": "pnpm --filter @ai-knowledge-platform/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @ai-knowledge-platform/api test:watch",
    "db:generate": "pnpm --filter @ai-knowledge-platform/api prisma:generate",
    "db:validate": "pnpm --filter @ai-knowledge-platform/api prisma:validate"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
